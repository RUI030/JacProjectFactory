"""Graph data model for the grad student paper library.

A single `Paper` node type, flat records stored on the shared guest `root`.
No edges: papers are flat, so all traversal is the untyped `[root -->]` walk.

The built-in `jid` identifier is auto-generated by the runtime — it is NOT
declared here (line 29 of pipeline.md).
"""

import from datetime { datetime }

node Paper {
    has title: str,
        author: str,
        summary: str,
        source_url: str,
        tags: list[str] = [],
        created_at: datetime | None = None;
}
